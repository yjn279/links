# Flutter --dart-define variables
# Pass these via: flutter run --dart-define=LINKS_BACKEND_URL=... --dart-define=LINKS_BACKEND_TOKEN=...
# Or via a file: flutter run --dart-define-from-file=.env.local
LINKS_BACKEND_URL=https://your-worker.workers.dev
LINKS_BACKEND_TOKEN=replace-with-shared-token

# Backend (Cloudflare Worker) secrets — set via wrangler secret put
# ANTHROPIC_API_KEY
# LINKS_BACKEND_TOKEN
