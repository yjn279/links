# Optional. The app works out of the box against a public demo Supabase
# project. To point it at your own project instead, copy this file and fill in
# your URL and anon key:
#
#   cp .env.example .env.local
#   # edit .env.local with your values, then restart Metro: npx expo start --clear
#
# Get your URL and anon key from: Supabase Dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
