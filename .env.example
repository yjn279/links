# Copy this file to .env.local and fill in your Supabase project credentials.
# The app will display a "Supabase Setup Required" screen until both values are set.
#
#   cp .env.example .env.local
#   # then edit .env.local with real values, and restart Metro: npx expo start --clear
#
# Get your URL and anon key from: Supabase Dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
